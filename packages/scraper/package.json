{
  "name": "@busquedastiendas/scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "tsx src/index.ts",
    "scrape:dry": "tsx src/index.ts --dry-run",
    "scrape:fixtures": "tsx src/index.ts --stores=fixture --dry-run",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "diagnose": "tsx src/diagnose.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
