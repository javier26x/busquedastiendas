rules_version = '2';

// Reglas del monitor de precios.
//
// Modelo de acceso: el panel es de solo lectura y privado. Toda la escritura
// la hace el scraper con el Admin SDK, que se salta estas reglas por diseno;
// por eso aca ningun cliente puede escribir nunca.
//
// Para dar acceso a otra persona: crea un documento vacio en la coleccion
// `allowedUsers` cuyo id sea su correo (ej: allowedUsers/otra@gmail.com).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'javier.neo@gmail.com'
          || exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))
        );
    }

    match /products/{productId} {
      allow read: if isAllowed();

      // Al borrar una busqueda, el panel desliga sus productos quitando esa
      // etiqueta. Solo puede tocar `searchIds`: el resto de los campos, y el
      // borrado del documento, son del scraper, que ademas puede eliminar la
      // subcoleccion de historial (un cliente dejaria esos registros huerfanos).
      allow update: if isAllowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['searchIds'])
        && request.resource.data.searchIds is list;

      allow create, delete: if false;

      match /history/{entryId} {
        allow read: if isAllowed();
        allow write: if false;
      }
    }

    // Las busquedas si las administra el usuario desde el panel. Se valida
    // la forma porque el scraper depende de ella para correr.
    function validSearch() {
      let d = request.resource.data;
      return d.label is string
        && d.label.size() > 0 && d.label.size() <= 60
        && d.queries is list
        && d.queries.size() > 0 && d.queries.size() <= 10
        && d.enabled is bool
        && d.match is map
        // Cada grupo va como { anyOf: [...] }: Firestore no admite
        // arreglos anidados.
        && d.match.requireAll is list
        && d.match.requireAll.size() <= 10
        && d.match.exclude is list
        && d.match.exclude.size() <= 30;
    }

    match /searches/{searchId} {
      allow read: if isAllowed();
      allow create, update: if isAllowed() && validSearch();
      allow delete: if isAllowed();
    }

    match /runs/{runId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // El usuario puede ver quien tiene acceso, pero no modificarlo desde la web.
    match /allowedUsers/{email} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Configuracion interna: hoy, el token con el que el boton "Actualizar
    // ahora" dispara el workflow del scraper. Solo lo lee un correo autorizado
    // (por eso no puede ir en el bundle publico), y solo lo escribe el dueno
    // con credenciales de admin (scripts/set-github-token.sh), nunca el cliente.
    match /config/{doc} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Cualquier otra ruta queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
